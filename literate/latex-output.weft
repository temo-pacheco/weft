\section{Writing the Latex File} \label{latex-file}

The second pass (invoked via a call to \verb|write_tex|) copies most of
the text from the source file straight into a \verb|.tex| file.
Definitions are formatted slightly and cross-reference information is
printed out.

Note that all the formatting is handled in this section.
If you don't like the format of definitions or indices or whatever,
it'll be in this section somewhere. Similarly, if someone wanted to
modify weft to work with a different typesetting system, this would
be the place to look.

@d Function...
@{extern void write_tex(char *file_name, char *tex_name, unsigned char sector);
@}

We need a few local function declarations before we get into the body
of \verb|write_tex|.

@o latex.c
@{static void copy_scrap(FILE *file, int prefix, Name *name);             /* formats the body of a scrap */
static void latex_code_putc(FILE *file, int c);                          /* escapes one code character for LaTeX */
static const char *latex_language(const char *lang);                     /* maps a weft language tag to a listings name */
static void print_scrap_numbers(FILE *tex_file, Scrap_Node *scraps);      /* formats a list of scrap numbers */
static void format_entry(Name *name, FILE *tex_file, unsigned char sector);             /* formats an index entry */
static void format_file_entry(Name *name, FILE *tex_file);        /* formats a file index entry */
static void format_user_entry(Name *name, FILE *tex_file, unsigned char sector);
static void write_arg(FILE *tex_file, char *p);
static void write_literal(FILE *tex_file, char *p, int mode);
static void write_ArglistElement(FILE *file, Arglist *args, char **params);
@}


The routine \verb|write_tex| takes two file names as parameters: the
name of the web source file and the name of the \verb|.tex| output file.
@o latex.c
@{void write_tex(char *file_name, char *tex_name, unsigned char sector)
{
  (void)sector;
  FILE *tex_file = fopen(tex_name, "w");
  if (tex_file) {
    if (verbose_flag)
      fprintf(stderr, "writing %s\n", tex_name);
    source_open(file_name);
    @<Write LaTeX limbo definitions@>
    @<Copy \verb|source_file| into \verb|tex_file|@>
    fclose(tex_file);
  }
  else
    fprintf(stderr, "%s: can't open %s\n", command_name, tex_name);
}
@| write_tex @}


Weft's woven output relies on a family of \verb|\WEFT...| macros.  We
write default definitions for all of them into the document's limbo so
that source files need not define anything new.  If a user wants to
change any of the macros (to use hyperref, to write in some language
other than english, or to tune the code layout) he or she can redefine
the commands \emph{after} the point where weft's definitions are read,
or (better) redefine them in the preamble with \verb|\renewcommand|.

Three groups of macros are written.  The first group are the textual and
cross-reference macros (\verb|\WEFTtarget|, \verb|\WEFTlink|, the
\verb|\WEFTtxt...| labels, and so on).  The second group, the
\emph{modern decoration macros} of \S\ref{modern-decoration}, give a
scrap its visual identity (fragment name, scrap number, the
\(\equiv\)/\(+\!\equiv\) marker, the one-line footer) and route all
colour through the degradable \verb|\WEFTtint| indirection.  The third
group, written by the scrap-formatting fragment below, are the layout
macros that frame a scrap.

Code bodies are typeset with the \texttt{listings} package: every scrap
becomes an \verb|lstlisting| environment.  This gives syntax
highlighting (driven by the scrap's language, see \verb|latex_language|),
automatic line wrapping (\verb|breaklines|), and page breaking for free.
The document \emph{must} therefore load \verb|\usepackage{listings}| in
its preamble --- weft cannot inject it, because the limbo is written
before \verb|\documentclass| (a colour package, \verb|color| or
\verb|xcolor|, is likewise the user's to load, and enables the accent and
syntax colours; without it the output still compiles in black and
white).  Fragment references that appear in the
middle of code are typeset by briefly escaping out of the listing back
to \LaTeX; see \S\ref{latex-file} and the \verb|escapeinside| option.

@d Write LaTeX limbo definitions
@{if (hyperref_flag) {
   fputs("\\newcommand{\\WEFTtarget}[2]{\\hypertarget{#1}{#2}}\n", tex_file);
   fputs("\\newcommand{\\WEFTlink}[2]{\\hyperlink{#1}{#2}}\n", tex_file);
} else {
   fputs("\\newcommand{\\WEFTtarget}[2]{#2}\n", tex_file);
   fputs("\\newcommand{\\WEFTlink}[2]{#2}\n", tex_file);
}
fputs("\\newcommand{\\WEFTtxtMacroDefBy}{defined at}\n", tex_file);
fputs("\\newcommand{\\WEFTtxtMacroRefIn}{used in}\n", tex_file);
fputs("\\newcommand{\\WEFTtxtMacroNoRef}{unreferenced}\n", tex_file);
fputs("\\newcommand{\\WEFTtxtDefBy}{defined at}\n", tex_file);
fputs("\\newcommand{\\WEFTtxtRefIn}{used in}\n", tex_file);
fputs("\\newcommand{\\WEFTtxtNoRef}{unreferenced}\n", tex_file);
fputs("\\newcommand{\\WEFTtxtFileDefBy}{defined at}\n", tex_file);
fputs("\\newcommand{\\WEFTtxtIdentsUsed}{uses}\n", tex_file);
fputs("\\newcommand{\\WEFTtxtIdentsNotUsed}{never used}\n", tex_file);
fputs("\\newcommand{\\WEFTtxtIdentsDefed}{defines}\n", tex_file);
fputs("\\newcommand{\\WEFTsep}{}\n", tex_file);
fputs("\\newcommand{\\WEFTnotglobal}{(not defined globally)}\n", tex_file);
@<Write the modern decoration macros@>
@<Write the scrap formatting macros@>
fputs("\\newcommand{\\WEFTuseHyperlinks}{", tex_file);
if (hyperoptions[0] != '\0')
{
   @<Write the hyperlink usage macro@>
}
fputs("}\n", tex_file);
@<Write the AtBeginDocument setup@>
@}

The layout macros.  \verb|\WEFTbegin|/\verb|\WEFTend| open and close the
vertical block that holds a scrap's header line, its \verb|lstlisting|
body, and its one-line metadata footer.  \verb|\WEFTbegin| sets the block
ragged-right at the document's ordinary size (the old \verb|\small| is
gone: the header now reads at full size, and the code carries its own,
tighter, listings size).  A fragment reference appearing in
the middle of code is assembled inline and wrapped in an \verb|\hbox| so
that \verb|listings|' line-breaker never splits it while it sits inside
an escape.  (We use \verb|\hbox| rather than \verb|\mbox| because a
fragment name may legitimately contain \verb|\verb|, which is illegal in
a macro argument such as \verb|\mbox|'s but fine inside a primitive
\verb|\hbox|.)  \verb|\WEFTlstsetup| now carries weft's \emph{modern}
\verb|\lstset| defaults: a compact monospace with tightened leading,
coloured keywords/strings/comments (through \verb|\WEFTtint|, so colour
is optional), line breaking, and \emph{no} frame, background, or left
indent.  The user need not call it --- the \verb|\AtBeginDocument| hook
of \S\ref{modern-decoration} applies it automatically once
\verb|listings| is loaded --- but an explicit call, or a
\verb|\renewcommand|, still lets the user override the house style.

@d Write the scrap formatting macros
@{fputs("\\newcommand{\\WEFTbegin}{\\par\\addvspace{2.3ex plus .6ex}"
      "\\begingroup\\raggedright}\n", tex_file);
fputs("\\newcommand{\\WEFTend}{\\par\\endgroup"
      "\\addvspace{2.3ex plus .6ex}}\n", tex_file);
fputs("\\providecommand{\\WEFTlstsetup}{\\lstset{basicstyle=\\ttfamily"
      "\\fontsize{10pt}{10.8pt}\\selectfont,"
      "keywordstyle={\\WEFTtint{weftkw}\\bfseries},"
      "commentstyle={\\WEFTtint{weftcom}\\itshape},"
      "stringstyle={\\WEFTtint{weftstr}},"
      "breaklines=true,breakatwhitespace=false,"
      "columns=fullflexible,keepspaces=true,showstringspaces=false,"
      "tabsize=8,frame=none,xleftmargin=0pt,"
      "aboveskip=0pt,belowskip=0pt}}\n", tex_file);
@}

@d Write the hyperlink usage macro
@{fprintf(tex_file, "\\usepackage[%s]{hyperref}", hyperoptions);@}

\subsubsection{The modern decoration macros}
\label{modern-decoration}

The visual identity of a woven scrap --- the way a fragment name reads,
the little scrap number beside it, the definition/continuation marker,
the one-line metadata footer --- is factored into a handful of small
macros written here.  Emitting them once, as named commands, keeps the
per-scrap output that follows compact and lets a reader (or the user)
re-style the whole document by redefining a single command.

The design is \emph{sober and self-contained}: a fragment name is set in
the document's ordinary italic tinted with one accent colour, its scrap
number in a small grey, the enclosing \(\langle\ \rangle\) in the same
grey, and the modern layout carries \emph{no} rules, boxes, or shaded
backgrounds --- highlighting alone distinguishes the code.

Colour is applied through one level of indirection, \verb|\WEFTtint|.
By default it is a no-op: \verb|\WEFTtint{weftaccent}| expands to nothing,
so a document that loads \emph{no} colour package still compiles, merely
in black and white.  When a colour package \emph{is} present, the
\verb|\AtBeginDocument| hook below swaps in \verb|\WEFTtintOn|, and the
same call becomes \verb|\color{weftaccent}|.  This is why every colour
site is written \verb|{\WEFTtint{name}...}| rather than \verb|\color|
directly: it degrades gracefully.

\verb|\WEFTlangle|/\verb|\WEFTrangle| are the grey angle brackets;
\verb|\WEFTeq| and \verb|\WEFTpluseq| are the definition (\(\equiv\)) and
additive-continuation (\(+\!\equiv\)) markers; \verb|\WEFTdot| is the
mid-dot that separates footer items; and \verb|\WEFTmetabegin|/%
\verb|\WEFTmetaend| open and close the small grey metadata line, which
opens with the scrap's own number.

@d Write the modern decoration macros
@{fputs("\\newcommand{\\WEFTtint}[1]{}\n", tex_file);
fputs("\\newcommand{\\WEFTtintOn}[1]{\\color{#1}}\n", tex_file);
fputs("\\newcommand{\\WEFTlangle}{{\\WEFTtint{weftcom}$\\langle$}\\,}\n",
      tex_file);
fputs("\\newcommand{\\WEFTrangle}{\\,{\\WEFTtint{weftcom}$\\rangle$}}\n",
      tex_file);
fputs("\\newcommand{\\WEFTeq}{\\ {\\WEFTtint{weftcom}$\\equiv$}}\n",
      tex_file);
fputs("\\newcommand{\\WEFTpluseq}{\\ {\\WEFTtint{weftcom}"
      "$\\mathord{+}\\equiv$}}\n", tex_file);
fputs("\\newcommand{\\WEFTdot}{\\ {\\WEFTtint{weftcom}"
      "\\textperiodcentered}\\ }\n", tex_file);
fputs("\\newcommand{\\WEFTmetabegin}[1]{\\par\\vspace{3pt}\\begingroup"
      "\\footnotesize\\WEFTtint{weftcom}#1}\n", tex_file);
fputs("\\newcommand{\\WEFTmetaend}{\\endgroup\\par}\n", tex_file);
@}

The colours themselves, and the automatic application of
\verb|\WEFTlstsetup|, are deferred to \verb|\AtBeginDocument|.  This is
essential: the limbo we are writing precedes \verb|\documentclass|, where
\verb|\definecolor| and \verb|\lstset| cannot run (no colour or listings
package is loaded yet, and loading one there fails outright).  The kernel
hook \verb|\AtBeginDocument| runs its body at \verb|\begin{document}|, by
which time the user's preamble has loaded its packages.  We guard each
half with \(\varepsilon\)-\TeX's \verb|\ifdefined| so the output still
compiles when a colour package or \verb|listings| is absent.  The palette
uses the \verb|rgb| model, understood by both \verb|color| and
\verb|xcolor|, so no specific colour package is mandated.

@d Write the AtBeginDocument setup
@{fputs("\\AtBeginDocument{%\n", tex_file);
fputs("\\ifdefined\\definecolor\n", tex_file);
fputs("\\definecolor{weftaccent}{rgb}{0.184,0.435,0.922}%\n", tex_file);
fputs("\\definecolor{weftkw}{rgb}{0.020,0.314,0.682}%\n", tex_file);
fputs("\\definecolor{weftstr}{rgb}{0.067,0.388,0.161}%\n", tex_file);
fputs("\\definecolor{weftcom}{rgb}{0.431,0.467,0.506}%\n", tex_file);
fputs("\\let\\WEFTtint\\WEFTtintOn\n", tex_file);
fputs("\\fi\n", tex_file);
fputs("\\ifdefined\\lstset\\WEFTlstsetup\\fi\n", tex_file);
fputs("}\n", tex_file);
@}

We make our second (and final) pass through the source web, this time
copying characters straight into the \verb|.tex| file. However, we keep
an eye peeled for \verb|@@|~characters, which signal a command sequence.

@d Copy \verb|source_file| into \verb|tex_file|
@{{
  int inBlock = FALSE;
  int c = source_get();
  while (c != EOF) {
    if (c == nw_char)
      {
      @<Interpret at-sequence@>
      }
    else {
      putc(c, tex_file);
      c = source_get();
    }
  }
}@}

@d Interpret at-sequence
@{{
  int big_definition = FALSE;
  c = source_get();
  switch (c) {
    case 'r':
          c = source_get();
          nw_char = c;
          update_delimit_scrap();
          break;
    case 'O': big_definition = TRUE;
              FALLTHROUGH;
    case 'o': @<Write output file definition@>
              break;
    case 'Q':
    case 'D': big_definition = TRUE;
              FALLTHROUGH;
    case 'q':
    case 'd': @<Write macro definition@>
              break;
    case 's':
              @<Step to next sector@>
              break;
    case 'S':
              @<Close the current sector@>
              break;
    case '{':
    case '[':
    case '(': @<Write in-text scrap@>
              break;
    case '<': @<Expand macro into @'tex_file@'@>
              break;
    case 'x': @<Copy label from source into@(tex_file@)@>
              c = source_get();
              break;
    case 'c': @<Begin or end a block comment@>
              c = source_get();
              break;
    case 'f': @<Write index of file names@>
              break;
    case 'm': @<Write index of macro names@>
              break;
    case 'u': @<Write index of user-specified names@>
              break;
    case 'v': @<Copy version info into tex file@>
              break;
    case 'l':
    case 'L': @<Skip at-L language definition line@>
              break;
    case 'W': @<Skip at-L language definition line@>
              break;
    default:
          if (c==nw_char)
            putc(c, tex_file);
          c = source_get();
              break;
  }
}@}

@d Copy version info into tex file
@{fputs(version_string, tex_file);
c = source_get();
@}

@d Expand macro into @'file@'
@{{
   Parameters local_parameters = 0;
   int changed;
   char indent_chars[MAX_INDENT];
   Arglist *a;
   Name *name;
   Arglist * args;
   a = collect_scrap_name(0);
   name = a->name;
   args = instance(a->args, NULL, NULL, &changed);
   name->mark = TRUE;
   write_scraps(@1, tex_name, name->defs, 0, indent_chars, 0, 0, 1, 0, 0,
         args, name->arg, local_parameters, tex_name);
   name->mark = FALSE;
   c = source_get();
}
@}

\subsection{Formatting Definitions}

We go through a fair amount of effort to format a fragment definition.
The \LaTeX\ for the previous fragment definition should look like this
(perhaps modulo the scrap references).  Note the shape of a modern
header: the grey \verb|\WEFTlangle|/\verb|\WEFTrangle| brackets, the
accent-tinted italic name, the small grey scrap number, and the
\verb|\WEFTeq| (\(\equiv\)) kind marker; then a hair of space before the
listing; and, after it, the one-line \verb|\WEFTmetabegin|\ldots
\verb|\WEFTmetaend| footer instead of the old bulleted list.
{\small
\begin{verbatim}
\WEFTbegin
\label{scrap70}
\WEFTtarget{weft70}{}\WEFTlangle{\WEFTtint{weftaccent}\itshape %
  Interpret at-sequence}\nobreak\,{\footnotesize\WEFTtint{weftcom}70}%
  \WEFTrangle\WEFTeq\par\nobreak\vspace{0.6ex}\nobreak
\begin{lstlisting}[escapeinside={(*<}{>*)},language=C]
{
  int big_definition = FALSE;
  c = source_get();
  switch (c) {
    case 'o': (*<\hbox{\normalfont \WEFTlangle{\WEFTtint{weftaccent}%
  \itshape Write output file definition}\nobreak\,{\footnotesize%
  \WEFTtint{weftcom}\WEFTlink{weft19a}{19a}}\WEFTrangle}>*)
  }
\end{lstlisting}
\WEFTmetabegin{70}\WEFTdot \WEFTtxtMacroRefIn\ \WEFTlink{weft17b}{17b}\WEFTmetaend
\WEFTend
\end{verbatim}}

\noindent
The code body is now an \verb|lstlisting|.  Because \verb|listings|
reads the body verbatim, the special \LaTeX\ characters need \emph{no}
escaping --- they are printed as typed.  The \verb|escapeinside={(*<}{>*)}|
option carves out the one place we \emph{do} need \LaTeX: a fragment
reference in the middle of code, which is emitted between \verb|(*<| and
\verb|>*)| and wrapped in an \verb|\hbox| so \verb|breaklines| cannot
split it.  The delimiter pair \verb|(*<|\ldots\verb|>*)| is deliberately
chosen to be a sequence that never occurs in real source (weft warns if
a scrap body contains it).  \verb|listings| supplies page breaking,
line wrapping, and --- via the \verb|language=| option, taken from the
scrap's language tag --- syntax highlighting.

Fragment and file definitions are formatted nearly identically.
I've factored the common parts out into separate scraps.

Both headers now carry a \emph{kind marker} after the closing angle
bracket: \verb|\WEFTeq| (\(\equiv\)) for a definition, or
\verb|\WEFTpluseq| (\(+\!\equiv\)) for an \emph{additive continuation}
--- a scrap that appends to a fragment (or file) already begun elsewhere.
We know which is which because \verb|name->defs| is, after pass~one's
\verb|reverse_lists|, in source order: its head is the \emph{first}
scrap that defines the name.  So the current scrap is a continuation
exactly when \verb|name->defs->scrap| differs from the scrap we are
emitting.  The file header sets the file name in monospace (it \emph{is}
a filename); the fragment header sets its name in the document's italic.
Both are tinted with the accent colour and followed, on the next line
after a hair of vertical space, by the code.

@d Write output file definition
@{{
  Name *name = collect_file_name();
  int additive = (name->defs && name->defs->scrap != scraps);
  @<Begin the scrap environment@>
  fputs("\\WEFTtarget{weft", tex_file);
  write_single_scrap_ref(tex_file, scraps);
  fputs("}{}", tex_file);
  fprintf(tex_file, "\\WEFTlangle{\\WEFTtint{weftaccent}\\verb%c%s%c}\\nobreak"
          "\\,{\\footnotesize\\WEFTtint{weftcom}", nw_char, name->spelling, nw_char);
  write_single_scrap_ref(tex_file, scraps);
  fputs("}\\WEFTrangle", tex_file);
  fputs(additive ? "\\WEFTpluseq" : "\\WEFTeq", tex_file);
  fputs("\\par\\nobreak\\vspace{0.6ex}\\nobreak\n", tex_file);
  @<Fill in the middle of the scrap environment@>
  @<Begin the cross-reference environment@>
  if ( scrap_flag ) {
    @<Write file defs@>
  }
  format_defs_refs(tex_file, scraps);
  format_uses_refs(tex_file, scraps++);
  @<Finish the cross-reference environment@>
  @<Finish the scrap environment@>
}@}


The fragment name's \emph{content} is still emitted verbatim by the
\emph{Write the macro's name} fragment, so a programmer may put italics
or bold face in the midst of the name; the surrounding \verb|\itshape|
and accent tint are only the default dress.

@d Write macro definition
@{{
  Name *name = collect_macro_name();
  int additive = (name->defs && name->defs->scrap != scraps);

  @<Begin the scrap environment@>
  fputs("\\WEFTtarget{weft", tex_file);
  write_single_scrap_ref(tex_file, scraps);
  fputs("}{}\\WEFTlangle{\\WEFTtint{weftaccent}\\itshape ", tex_file);
  @<Write the macro's name@>
  fputs("}\\nobreak\\,{\\footnotesize\\WEFTtint{weftcom}", tex_file);
  write_single_scrap_ref(tex_file, scraps);
  fputs("}\\WEFTrangle", tex_file);
  fputs(additive ? "\\WEFTpluseq" : "\\WEFTeq", tex_file);
  fputs("\\par\\nobreak\\vspace{0.6ex}\\nobreak\n", tex_file);
  @<Fill in the middle of the scrap environment@>
  @<Begin the cross-reference environment@>
  @<Write macro defs@>
  @<Write macro refs@>
  format_defs_refs(tex_file, scraps);
  format_uses_refs(tex_file, scraps++);
  @<Finish the cross-reference environment@>
  @<Finish the scrap environment@>
}@}

@d Write the macro's name
@{{
  char * p = name->spelling;
  int i = 0;

  while (*p != '\000') {
    if (*p == ARG_CHR) {
      write_arg(tex_file, name->arg[i++]);
      p++;
    }
    else
       fputc(*p++, tex_file);
  }
}@}

@o latex.c
@{static void write_arg(FILE * tex_file, char * p)
{
   fputs("\\hbox{\\slshape\\sffamily ", tex_file);
   while (*p)
   {
      switch (*p)
      {
      case '$':
      case '_':
      case '^':
      case '#':
         fputc('\\', tex_file);
         break;
      default:
         break;
      }
      fputc(*p, tex_file);
      p++;
   }

   fputs("\\/}", tex_file);
}
@| write_arg @}

A scrap is opened with \verb|\WEFTbegin| and closed with \verb|\WEFTend|
(both defined among the scrap-formatting macros above).  Both big
(\verb|@@O|, \verb|@@D|) and small (\verb|@@o|, \verb|@@d|) definitions use the same
breakable block; the \verb|inBlock| bookkeeping lets a run of small
definitions share one open group, separated by a little vertical space.

@d Begin the scrap environment
@{{
  if (big_definition)
  {
    if (inBlock)
    {
       @<End block@>
    }
    fputs("\\WEFTbegin", tex_file);
  }
  else
  {
    if (inBlock)
    {
       @<Switch block@>
    }
    else
    {
       @<Start block@>
    }
  }
  fprintf(tex_file, "\\label{scrap%d}\n", scraps);
}@}

@d Start block
@{fputs("\\WEFTbegin\n", tex_file);
inBlock = TRUE;@}

@d Switch block
@{fputs("\\par\\vspace{\\baselineskip}\n",  tex_file);@}

@d End block
@{fputs("\\WEFTend\n", tex_file);
inBlock = FALSE;@}

The body of a code scrap (\verb|@@{...@@}|) is emitted as an
\verb|lstlisting|.  We tag it with our fixed \verb|escapeinside| pair and,
when the scrap has a language listings understands, with a
\verb|language=| option so the code is highlighted.

Both ends of the listing must sit on their own lines.  We emit a newline
right after the closing \verb|]| of the options, so the first line of code
starts fresh; without it a scrap beginning with \verb|#| (a C
\verb|#ifndef|, say) would land immediately after \verb|]|, and
\verb|listings| reads that \verb|#| as a macro parameter and aborts with
\emph{Illegal parameter number}.  Symmetrically, \verb|\end{lstlisting}|
must start its own line, so we emit a newline before it even when the scrap
body did not end in one.  The modern layout draws no end-of-scrap glyph:
the old diamond (\verb|\WEFTsep|) is retired --- its macro is still
defined, but empty, for backward compatibility --- and the metadata
footer that follows delimits the scrap on its own.  A non-code block
scrap (the unusual \verb|@@d name @@[...@@]| or \verb|@@(...@@)| forms) is
emitted as before, without a listing.

@d Fill in the middle of the scrap environment
@{{
  int is_code = (source_last == '{');
  if (is_code) {
    const char *lstlang = latex_language(name->lang);
    /* the delimiter halves are split so this source line does not itself
       contain the escape sequence when weft typesets its own source */
    fputs("\\begin{lstlisting}[escapeinside={(*" "<}{>" "*)}", tex_file);
    if (lstlang)
      fprintf(tex_file, ",language=%s", lstlang);
    /* newline after ']' so the first code line starts fresh; a scrap
       beginning with '#' would otherwise break listings (see prose above) */
    fputs("]\n", tex_file);
  }
  extra_scraps = 0;
  copy_scrap(tex_file, TRUE, name);
  if (is_code)
    /* the closing tag is split across two literals so that this very
       line does not end a listing when weft typesets its own source
       (the same reason this comment says "the closing tag" rather than
       spelling it out); the leading newline keeps it on its own line */
    fputs("\n\\end{ls" "tlisting}\n", tex_file);
}@}

\newpage
\noindent
We've got one last spacing command, controlling the amount of white
space after a scrap.

Note also the whitespace eater. I use it to remove any blank lines
that appear after a scrap in the source file. This way, text following
a scrap will not be indented. Again, this is a matter of personal taste.

@d Finish the scrap environment
@{{
  scraps += extra_scraps;
  if (big_definition)
    fputs("\\WEFTend\n", tex_file);
  else
  {
     @<End block@>
  }
  do
    c = source_get();
  while (isspace(c));
}@}

@d Global variable declar...
@{extern int extra_scraps;
@| extra_scraps @}

@d Global variable def...
@{int extra_scraps = 0;
 @}

@d Write in-text scrap
@{copy_scrap(tex_file, FALSE, NULL);
c = source_get();
@}

\subsubsection{Formatting Cross References}

@d Begin the cross-reference environment
@{{
  fputs("\\WEFTmetabegin{", tex_file);
  write_single_scrap_ref(tex_file, scraps);
  fputs("}", tex_file);}
@}

The footer is one horizontal line, opened above with the scrap's own
number.  Every subsequent item is introduced by \verb|\WEFTdot|, the grey
separator, so there is never a leading or trailing dot to special-case;
an item that has nothing to say simply emits nothing.

@d Finish the cross-reference environment
@{{
  fputs("\\WEFTmetaend\n", tex_file);
}@}

@d Write file defs
@{{
  if (name->defs) {
    if (name->defs->next) {
      fputs("\\WEFTdot \\WEFTtxtFileDefBy\\ ", tex_file);
      print_scrap_numbers(tex_file, name->defs);
    }
  } else {
    fprintf(stderr,
            "would have crashed in 'Write file defs' for '%s'\n",
             name->spelling);
  }
}@}

@d Write macro defs
@{{
  if (name->defs->next) {
    fputs("\\WEFTdot \\WEFTtxtMacroDefBy\\ ", tex_file);
    print_scrap_numbers(tex_file, name->defs);
  }
}@}

@d Write macro refs
@{{
  if (name->uses) {
    if (name->uses->next) {
      fputs("\\WEFTdot \\WEFTtxtMacroRefIn\\ ", tex_file);
      print_scrap_numbers(tex_file, name->uses);
    }
    else {
      fputs("\\WEFTdot \\WEFTtxtMacroRefIn\\ ", tex_file);
      fputs("\\WEFTlink{weft", tex_file);
      write_single_scrap_ref(tex_file, name->uses->scrap);
      fputs("}{", tex_file);
      write_single_scrap_ref(tex_file, name->uses->scrap);
      fputs("}", tex_file);
    }
  }
  else {
    fputs("\\WEFTdot {\\WEFTtxtMacroNoRef}", tex_file);
    fprintf(stderr, "%s: <%s> never referenced.\n",
            command_name, name->spelling);
  }
}@}

@o latex.c
@{static void print_scrap_numbers(FILE *tex_file, Scrap_Node *scraps)
{
  int page;
  fputs("\\WEFTlink{weft", tex_file);
  write_scrap_ref(tex_file, scraps->scrap, -1, &page);
  fputs("}{", tex_file);
  write_scrap_ref(tex_file, scraps->scrap, TRUE, &page);
  fputs("}", tex_file);
  scraps = scraps->next;
  while (scraps) {
    fputs("\\WEFTlink{weft", tex_file);
    write_scrap_ref(tex_file, scraps->scrap, -1, &page);
    fputs("}{", tex_file);
    write_scrap_ref(tex_file, scraps->scrap, FALSE, &page);
    scraps = scraps->next;
    fputs("}", tex_file);
  }
}
@| print_scrap_numbers @}

\subsubsection{Formatting a Scrap}

This is the only place we really care whether a scrap is
delimited with \verb|@@{...@@}|, \verb|@@[...@@]|, or \verb|@@(...@@)|,
and we base our output sequences on that.  The code (\verb|@@{...@@}|)
mode is now handled by \verb|listings|, so its per-line strings are all
empty: \verb|copy_scrap| just copies the body out verbatim, one raw line
per source line, and the surrounding \verb|lstlisting| does the
formatting.  The \verb|@@[...@@]| (verbatim \TeX) and \verb|@@(...@@)|
(math) modes keep their old inline treatment.

We still keep the array \texttt{delimit\_scrap}: it carries the small
\emph{begin}/\emph{end} strings for the math mode (a pair of \verb|$|)
and, for every mode, the single character that stands in for the weft
character.  Upon initialisation we copy the strings from
\texttt{orig\_delimit\_scrap} into a writeable array; we might change the
\emph{insert nw\_char} entry later, when the weft character changes.

@o latex.c
@{static char *orig_delimit_scrap[3][5] = {
  /* {} mode (code): begin, end, insert nw_char, prefix, suffix.
     All empty: listings copies the body verbatim, one raw line per
     source line, so there is no per-line wrapper. */
  { "", "", "@@", "", "" },
  /* [] mode: begin, end, insert nw_char, prefix, suffix */
  { "", "", "@@", "", "" },
  /* () mode: begin, end, insert nw_char, prefix, suffix */
  { "$", "$", "@@", "", "" },
};

static char *delimit_scrap[3][5];
@}

The function \texttt{initialise\_delimit\_scrap\_array} just copies the
originals into a writeable array.

@o latex.c
@{void initialise_delimit_scrap_array(void) {
  int i,j;
  for(i = 0; i < 3; i++) {
    for(j = 0; j < 5; j++) {
      if((delimit_scrap[i][j] = strdup(orig_delimit_scrap[i][j])) == NULL) {
        fprintf(stderr, "Not enough memory for string allocation\n");
        exit(EXIT_FAILURE);
      }
    }
  }
}
@}

Copying one code character to the \verb|.tex| file.  Because the code is
no longer wrapped in \verb|\verb|, every character that is special to
\LaTeX\ has to be turned into something harmless in \verb|\ttfamily|
text.  A literal space becomes \verb|\WEFTsp| (a breakable, fixed-width
the code body itself needs none of this --- \verb|listings| copies it
verbatim.  \verb|latex_code_putc| is used only for the little bits of
text that are emitted \emph{inside} an escape (a fragment reference's
name and its substituted arguments), which land in ordinary \LaTeX\
text mode and so must have the \LaTeX-special characters neutralised.

@o latex.c
@{static void latex_code_putc(FILE *file, int c)
{
  switch (c) {
    case '\\': fputs("\\textbackslash{}", file);  break;
    case '{':  fputs("\\{", file);                break;
    case '}':  fputs("\\}", file);                break;
    case '$':  fputs("\\$", file);                break;
    case '&':  fputs("\\&", file);                break;
    case '#':  fputs("\\#", file);                break;
    case '%':  fputs("\\%", file);                break;
    case '_':  fputs("\\_", file);                break;
    case '^':  fputs("\\textasciicircum{}", file);break;
    case '~':  fputs("\\textasciitilde{}", file); break;
    default:   putc(c, file);                     break;
  }
}
@| latex_code_putc @}

The language mapper turns a scrap's weft language tag (\verb|"c"|,
\verb|"python"|, \ldots) into the exact name \verb|listings| expects, or
\verb|NULL| when we have no safe mapping.  Returning \verb|NULL| (rather
than guessing) matters: \verb|listings| aborts the run on an unknown
\verb|language=|, so we only ever name languages it is known to ship.

@o latex.c
@{static const char *latex_language(const char *lang)
{
  static const struct { const char *tag, *lst; } map[] = {
    {"c","C"}, {"h","C"},
    {"cpp","C++"}, {"c++","C++"}, {"cc","C++"}, {"cxx","C++"},
    {"hpp","C++"}, {"hxx","C++"},
    {"java","Java"},
    {"python","Python"}, {"py","Python"},
    {"sql","SQL"},
    {"html","HTML"}, {"htm","HTML"}, {"xml","XML"},
    {"php","PHP"},
    {"perl","Perl"}, {"pl","Perl"},
    {"ruby","Ruby"}, {"rb","Ruby"},
    {"pascal","Pascal"}, {"pas","Pascal"},
    {"lisp","Lisp"}, {"el","Lisp"}, {"scheme","Lisp"},
    {"matlab","Matlab"},
    {"tex","[LaTeX]TeX"}, {"latex","[LaTeX]TeX"},
    {"make","make"}, {"makefile","make"},
    {"awk","Awk"},
    {"fortran","Fortran"}, {"f","Fortran"}, {"f90","Fortran"},
    {"r","R"}, {"lua","Lua"}, {"ada","Ada"},
    {"vhdl","VHDL"}, {"verilog","Verilog"},
    {"erlang","erlang"}, {"cobol","COBOL"}, {"eiffel","Eiffel"},
    {"ocaml","Caml"}, {"caml","Caml"},
    {NULL,NULL}
  };
  int i;
  if (lang == NULL || lang[0] == '\0')
    return NULL;
  for (i = 0; map[i].tag; i++) {
    const char *a = lang, *b = map[i].tag;
    while (*a && *b && tolower((unsigned char)*a) == (unsigned char)*b) { a++; b++; }
    if (*a == '\0' && *b == '\0')
      return map[i].lst;
  }
  return NULL;
}
@| latex_language @}

@d Function prototypes
@{void initialise_delimit_scrap_array(void);
@}

@o latex.c
@{int scrap_type = 0;
@| scrap_type @}

@o latex.c
@{static void write_literal(FILE * tex_file, char * p, int mode)
{
   fputs(delimit_scrap[mode][0], tex_file);
   while (*p!= '\000') {
     if (*p == nw_char)
       fputs(delimit_scrap[mode][2], tex_file);
     else if (mode == 0)
       latex_code_putc(tex_file, (unsigned char)*p);
     else
       fputc(*p, tex_file);
     p++;
   }
   fputs(delimit_scrap[mode][1], tex_file);
}
@| write_literal @}

Two little helpers bracket every place where we must step out of the
verbatim body to run \LaTeX\ (a fragment reference, a bold keyword, an
italic title, a substituted parameter).  In code mode this opens and
closes a \verb|listings| escape; in math mode it closes and reopens the
math run; in the verbatim-\TeX\ (\verb|@@[...@@]|) mode both are empty.

The escape delimiters are written with the two halves as separate string
literals (\verb|"(*" "<"|).  The C compiler concatenates them, so the
emitted text is exactly \verb|(*<|; but the \emph{source} never contains
the delimiter as one contiguous token, which matters because weft
typesets its own source --- otherwise these very lines would trip the
\verb|listings| tokeniser when they appear in a scrap.

When \verb|code_inline| is set we are already rendering inside an escape
(a parameter of a fragment reference), so we must \emph{not} open a
nested escape --- both helpers do nothing in code mode.

@o latex.c
@{int code_inline = FALSE;

static void begin_tex_escape(FILE *file)  /* leave the verbatim body */
{
  if (scrap_type == 0) { if (!code_inline) fputs("(*" "<", file); }
  else fputs(delimit_scrap[scrap_type][1], file);
}
static void end_tex_escape(FILE *file)      /* re-enter the verbatim body */
{
  if (scrap_type == 0) { if (!code_inline) fputs(">" "*)", file); }
  else fputs(delimit_scrap[scrap_type][0], file);
}
@| begin_tex_escape end_tex_escape code_inline @}

@o latex.c
@{static void copy_scrap(FILE *file, int prefix, Name *name)
{
  int indent = 0;
  int c;
  int coll_h1 = 0, coll_h2 = 0, coll_warned = FALSE;
  char ** params = name->arg;
  if (source_last == '{') scrap_type = 0;
  if (source_last == '[') scrap_type = 1;
  if (source_last == '(') scrap_type = 2;
  c = source_get();
  if (prefix) fputs(delimit_scrap[scrap_type][3], file);
  fputs(delimit_scrap[scrap_type][0], file);
  while (1) {
    switch (c) {
      case '\n': if (code_inline) {
                   putc(' ', file);   /* an inline parameter stays on one line */
                   indent = 0;
                   break;
                 }
                 fputs(delimit_scrap[scrap_type][1], file);
                 if (prefix) fputs(delimit_scrap[scrap_type][4], file);
                 fputs("\n", file);
                 if (prefix) fputs(delimit_scrap[scrap_type][3], file);
                 fputs(delimit_scrap[scrap_type][0], file);
                 indent = 0;
                 break;
      case '\t': @<Expand tab into spaces@>
                 break;
      default:
         if (c==nw_char)
           {
             @<Check at-sequence for end-of-scrap@>
             break;
           }
         if (code_inline)
           latex_code_putc(file, c);   /* inside an escape: neutralise LaTeX */
         else {
           @<Note a delimiter collision@>
           putc(c, file);
         }
                 indent++;
                 break;
    }
    c = source_get();
  }
}
@| copy_scrap scrap_type @}

When we encounter the command to change the `weft character' we call
this function. It updates the scrap formatting directives accordingly.

@o latex.c
@{void update_delimit_scrap(void)
{
  /* Every mode's "insert nw_char" string is the single character that
     stands in for the weft character inside a scrap; keep them in sync
     with the (possibly changed) weft character. */
  delimit_scrap[0][2][0] = nw_char;
  delimit_scrap[1][2][0] = nw_char;
  delimit_scrap[2][2][0] = nw_char;
}
@| update_delimit_scrap @}

@d Function prototypes
@{void update_delimit_scrap(void);
@}

@d Expand tab into spaces
@{{
  int delta = 8 - (indent % 8);
  indent += delta;
  while (delta > 0) {
    putc(' ', file);
    delta--;
  }
}@}

Since the code body is copied verbatim, a scrap that literally contains
our escape delimiter (\verb|(*<| or \verb|>*)|) would desynchronise
\verb|listings|' tokeniser.  This never happens in ordinary source, but
we watch a two-character rolling window and warn once per scrap if it
does, so a corrupted listing is never silent.

@d Note a delimiter collision
@{if (scrap_type == 0) {
  if ((coll_h2 == '(' && coll_h1 == '*' && c == '<') ||
      (coll_h2 == '>' && coll_h1 == '*' && c == ')')) {
    if (!coll_warned) {
      fprintf(stderr,
        "%s: warning: a scrap body contains the listings escape "
        "delimiter; its typeset code may be corrupted.\n", command_name);
      coll_warned = TRUE;
    }
  }
  coll_h2 = coll_h1;
  coll_h1 = c;
}@}

@d Check at-sequence...
@{{
  c = source_get();
  switch (c) {
    case 'c': @<Show presence of a block comment@>
              break;
    case 'x': @<Copy label from source into@(file@)@>
              break;
    case 'v': @<Copy version info into file@>
    case 's':
              break;
    case '+':
    case '-':
    case '*':
    case '|': @<Skip over index entries@>
              FALLTHROUGH;
    case ',':
    case ')':
    case ']':
    case '}': fputs(delimit_scrap[scrap_type][1], file);
              return;
    case '<': @<Format macro name@>
              break;
    case '%': @<Skip commented-out code@>
              break;
    case '_': @<Bold Keyword@>
              break;
    case 't': @<Italic "@'fragment title@'"@>
              break;
    case 'f': @<Italic "@'file name@'"@>
              break;
    case '1': case '2': case '3':
    case '4': case '5': case '6':
    case '7': case '8': case '9':
              if (name == NULL
                  || name->arg[c - '1'] == NULL) {
                fputs(delimit_scrap[scrap_type][2], file);
                fputc(c,   file);
              }
              else {
                begin_tex_escape(file);
                write_arg(file, name->arg[c - '1']);
                end_tex_escape(file);
              }
              break;
    default:
          if (c==nw_char)
            {
              fputs(delimit_scrap[scrap_type][2], file);
              break;
            }
          /* ignore these since pass1 will have warned about them */
              break;
  }
}@}

@d Copy version info into file
@{fputs(version_string, file);
@}

@d Copy label from source into
@{{
   @<Get label from@(source_get()@)@>
   write_label(label_name, @1);
}@}


There's no need to check for errors here, since we will have already
pointed out any during the first pass.
@d Skip over index entries
@{{
  do {
    do
      c = source_get();
    while (c != nw_char);
    c = source_get();
  } while (c != '}' && c != ']' && c != ')' );
}@}

@d Skip commented-out code...
@{{
        do
                c = source_get();
        while (c != '\n');
}@}

This scrap helps deal with bold keywords:

@d Bold Keyword
@{{
  begin_tex_escape(file);
  fprintf(file, "\\hbox{\\sffamily\\bfseries ");
  c = source_get();
  do {
      fputc(c, file);
      c = source_get();
  } while (c != nw_char);
  c = source_get();
  fprintf(file, "}");
  end_tex_escape(file);
}@}

@d Italic "@'whatever@'"
@{{
  begin_tex_escape(file);
  fprintf(file, "\\hbox{\\sffamily\\slshape @1}");
  end_tex_escape(file);
}@}

@d Format macro name
@{{
  Arglist *args = collect_scrap_name(-1);
  Name *name = args->name;
  char * p = name->spelling;
  Arglist *q = args->args;
  int narg = 0;

  begin_tex_escape(file);
  if (prefix)
    /* \normalfont resets the listing's \ttfamily basicstyle, so the
       fragment name is set in the ordinary document font (roman italic)
       rather than as italic typewriter. */
    fputs("\\hbox{\\normalfont ", file);
  fputs("\\WEFTlangle{\\WEFTtint{weftaccent}\\itshape ", file);
  while (*p != '\000') {
    if (*p == ARG_CHR) {
      if (q == NULL) {
         write_literal(file, name->arg[narg], scrap_type);
      }
      else {
        write_ArglistElement(file, q, params);
        q = q->next;
      }
      p++;
      narg++;
    }
    else
       fputc(*p++, file);
  }
  fputs("}\\nobreak", file);
  if (scrap_name_has_parameters) {
    @<Format macro parameters@>
  }
  fprintf(file, "\\,{\\footnotesize\\WEFTtint{weftcom}");
  if (name->defs)
    @<Write abbreviated definition list@>
  else {
    putc('?', file);
    fprintf(stderr, "%s: never defined <%s>\n",
            command_name, name->spelling);
  }
  fputs("}\\WEFTrangle", file);
  if (prefix)
     fputs("}", file);
  end_tex_escape(file);
}@}


@d Write abbreviated definition list
@{{
  Scrap_Node *p = name->defs;
  fputs("\\WEFTlink{weft", file);
  write_single_scrap_ref(file, p->scrap);
  fputs("}{", file);
  write_single_scrap_ref(file, p->scrap);
  fputs("}", file);
  p = p->next;
  if (p)
    fputs(", \\ldots\\ ", file);
}@}

A quoted scrap (\verb|@@{...@@}|) can appear as the argument of a
parameterised fragment reference, e.g.\ \hbox{\tt @@<Name @@\{code@@\}
eman@@>}.  In the old \verb|\verb|-based output that code was simply set
in a verbatim run in the middle of the reference.  Under \verb|listings|
we cannot leave the escape here --- the reference is being built inside an
\verb|\hbox|, and closing the escape mid-box would leave the braces
straddling the escape boundary (a \verb|! Extra }| error).  Instead we
capture the scrap's expansion into a memory buffer and re-emit it
\emph{inside} the escape, as \LaTeX-escaped typewriter text on a single
line, so the box stays balanced.

@d Emit a quoted scrap argument inline
@{{
  Scrap_Node * qq = (Scrap_Node *)q;
  char *buf = NULL;
  size_t sz = 0;
  FILE *mem = open_memstream(&buf, &sz);
  qq->quoted = TRUE;
  if (mem) {
    char *s;
    write_scraps(mem, "", qq, -1, "", 0, 0, 0, 0, 0, NULL, params, 0, "");
    fclose(mem);
    fputs("\\hbox{\\ttfamily ", file);
    for (s = buf; *s != '\0'; s++) {
      if (*s == '\n')
        putc(' ', file);
      else
        latex_code_putc(file, (unsigned char)*s);
    }
    fputs("}", file);
    free(buf);
  }
  extra_scraps++;
  qq->quoted = FALSE;
}@}

@o latex.c
@{static void
write_ArglistElement(FILE * file, Arglist * args, char ** params)
{
  Name *name = args->name;
  Arglist *q = args->args;

  if (name == NULL) {
    char * p = (char*)q;

    if (p[0] == ARG_CHR) {
       write_arg(file, params[p[1] - '1']);
    } else {
       write_literal(file, (char *)q, 0);
    }
  } else if (name == (Name *)1) {
    @<Emit a quoted scrap argument inline@>
  } else {
    char * p = name->spelling;
    fputs("$\\langle\\,${\\itshape ", file);
      while (*p != '\000') {
      if (*p == ARG_CHR) {
        write_ArglistElement(file, q, params);
        q = q->next;
        p++;
      }
      else
         fputc(*p++, file);
    }
    fputs("}\\nobreak\\ ", file);
    if (scrap_name_has_parameters) {
      int c;

      @<Format macro parameters@>
    }
    fprintf(file, "{\\footnotesize ");
    if (name->defs)
      @<Write abbreviated definition list@>
    else {
      putc('?', file);
      fprintf(stderr, "%s: never defined <%s>\n",
              command_name, name->spelling);
    }
    fputs("}$\\,\\rangle$", file);
  }
}
@| write_ArglistElement @}

\subsection{Generating the Indices}

The three back-of-book indices --- of file names, fragment names, and
user-specified identifiers --- are each a compact vertical list, one
entry per line.  Their entries share the scrap presentation's visual
language: a fragment name is set in the accent-tinted italic inside the
grey \verb|\WEFTlangle|/\verb|\WEFTrangle| brackets, a file name and an
identifier in accent and keyword-coloured monospace respectively, and
each entry's \verb|\WEFTtxtDefBy|/\verb|\WEFTtxtRefIn| metadata in the
small grey used everywhere else.  Colour flows through the same \verb|\WEFTtint|
indirection, so the indices too degrade to black and white when no colour
package is loaded.

@d Write index of file names
@{{
  if (file_names) {
    fputs("\n{\\small\\begin{list}{}{\\setlength{\\itemsep}{-\\parsep}",
          tex_file);
    fputs("\\setlength{\\itemindent}{-\\leftmargin}}\n", tex_file);
    format_file_entry(file_names, tex_file);
    fputs("\\end{list}}", tex_file);
  }
  c = source_get();
}@}

@o latex.c
@{static void format_file_entry(Name *name, FILE *tex_file)
{
  while (name) {
    format_file_entry(name->llink, tex_file);
    @<Format a file index entry@>
    name = name->rlink;
  }
}
@| format_file_entry @}

@d Format a file index entry
@{fputs("\\item ", tex_file);
fprintf(tex_file, "{\\WEFTtint{weftaccent}\\verb%c%s%c}\\ ",
        nw_char, name->spelling, nw_char);
@<Write file's defining scrap numbers@>
putc('\n', tex_file);@}

@d Write file's defining scrap numbers
@{{
  Scrap_Node *p = name->defs;
  fputs("{\\footnotesize\\WEFTtint{weftcom} {\\WEFTtxtDefBy}", tex_file);
  putc(' ', tex_file);
  if (p->next) {
    print_scrap_numbers(tex_file, p);
  }
  else {
    fputs("\\WEFTlink{weft", tex_file);
    write_single_scrap_ref(tex_file, p->scrap);
    fputs("}{", tex_file);
    write_single_scrap_ref(tex_file, p->scrap);
    fputs("}", tex_file);
  }
  putc('}', tex_file);
}@}

@d Write index of macro names
@{{
  unsigned char sector = current_sector;
  int c = source_get();
  if (c == '+')
     sector = 0;
  else
     source_ungetc(&c);
  if (has_sector(macro_names, sector)) {
    fputs("\n{\\small\\begin{list}{}{\\setlength{\\itemsep}{-\\parsep}",
          tex_file);
    fputs("\\setlength{\\itemindent}{-\\leftmargin}}\n", tex_file);
    format_entry(macro_names, tex_file, sector);
    fputs("\\end{list}}", tex_file);
  } else {
    fputs("None.\n", tex_file);
  }
}
c = source_get();
@}

@o latex.c
@{static int load_entry(Name * name, Name ** nms, int n)
{
   while (name) {
      n = load_entry(name->llink, nms, n);
      nms[n++] = name;
      name = name->rlink;
   }
   return n;
}
@| load_entry @}

@o latex.c
@{static void format_entry(Name *name, FILE *tex_file, unsigned char sector)
{
  Name ** nms = malloc(num_scraps()*sizeof(Name *));
  int n = load_entry(name, nms, 0);
  int i;

  @<Sort @'nms@' of size @'n@' for @<Rob's ordering@>@>
  for (i = 0; i < n; i++)
  {
     Name * name = nms[i];

     @<Format an index entry@>
  }
}
@| format_entry @}

@d Rob's...
@{robs_strcmp(ki->spelling, kj->spelling) < 0@}

@d Sort @'key@' of size @'n@' for @'ordering@'
@{int j;
for (j = 1; j < @2; j++)
{
   int i = j - 1;
   Name * kj = @1[j];

   do
   {
      Name * ki = @1[i];

      if (@3)
         break;
      @1[i + 1] = ki;
      i -= 1;
   } while (i >= 0);
   @1[i + 1] = kj;
}
@}

@d Format an index entry
@{if (name->sector == sector){
  fputs("\\item ", tex_file);
  fputs("\\WEFTlangle{\\WEFTtint{weftaccent}\\itshape ", tex_file);
  @<Write the macro's name@>
  fputs("}\\nobreak\\,{\\footnotesize\\WEFTtint{weftcom}", tex_file);
  @<Write defining scrap numbers@>
  fputs("}\\WEFTrangle\\ ", tex_file);
  @<Write referencing scrap numbers@>
  putc('\n', tex_file);
}@}

@d Write defining scrap numbers
@{{
  Scrap_Node *p = name->defs;
  if (p) {
    int page;
    fputs("\\WEFTlink{weft", tex_file);
    write_scrap_ref(tex_file, p->scrap, -1, &page);
    fputs("}{", tex_file);
    write_scrap_ref(tex_file, p->scrap, TRUE, &page);
    fputs("}", tex_file);
    p = p->next;
    while (p) {
      fputs("\\WEFTlink{weft", tex_file);
      write_scrap_ref(tex_file, p->scrap, -1, &page);
      fputs("}{", tex_file);
      write_scrap_ref(tex_file, p->scrap, FALSE, &page);
      fputs("}", tex_file);
      p = p->next;
    }
  }
  else
    putc('?', tex_file);
}@}

@d Write referencing scrap numbers
@{{
  Scrap_Node *p = name->uses;
  fputs("{\\footnotesize\\WEFTtint{weftcom} ", tex_file);
  if (p) {
    fputs("{\\WEFTtxtRefIn}", tex_file);
    putc(' ', tex_file);
    if (p->next) {
      print_scrap_numbers(tex_file, p);
    }
    else {
      fputs("\\WEFTlink{weft", tex_file);
      write_single_scrap_ref(tex_file, p->scrap);
      fputs("}{", tex_file);
      write_single_scrap_ref(tex_file, p->scrap);
      fputs("}", tex_file);
    }
  }
  else
    fputs("{\\WEFTtxtNoRef}", tex_file);
  putc('}', tex_file);
}@}

@d Function prototypes
@{extern int has_sector(Name *, unsigned char);
@}

@o latex.c
@{int has_sector(Name * name, unsigned char sector)
{
  while(name) {
    if (name->sector == sector)
       return TRUE;
    if (has_sector(name->llink, sector))
       return TRUE;
     name = name->rlink;
   }
   return FALSE;
}
@| has_sector @}

@d Write index of user-specified names
@{{
    unsigned char sector = current_sector;
    c = source_get();
    if (c == '+') {
       sector = 0;
       c = source_get();
    }
    if (has_sector(user_names, sector)) {
      fputs("\n{\\small\\begin{list}{}{\\setlength{\\itemsep}{-\\parsep}",
            tex_file);
      fputs("\\setlength{\\itemindent}{-\\leftmargin}}\n", tex_file);
      format_user_entry(user_names, tex_file, sector);
      fputs("\\end{list}}", tex_file);
    }
}@}


@o latex.c
@{static void format_user_entry(Name *name, FILE *tex_file, unsigned char sector)
{
  while (name) {
    format_user_entry(name->llink, tex_file, sector);
    @<Format a user index entry@>
    name = name->rlink;
  }
}
@| format_user_entry @}


@D Format a user index entry
@{if (name->sector == sector){
  Scrap_Node *uses = name->uses;
  if ( uses || dangling_flag ) {
    int page;
    Scrap_Node *defs = name->defs;
    fprintf(tex_file, "\\item {\\WEFTtint{weftkw}\\verb%c%s%c}: ",
            nw_char,name->spelling,nw_char);
    if (!uses) {
        fputs("(\\underline{", tex_file);
        fputs("\\WEFTlink{weft", tex_file);
        write_single_scrap_ref(tex_file, defs->scrap);
        fputs("}{", tex_file);
        write_single_scrap_ref(tex_file, defs->scrap);
        fputs("})}", tex_file);
        page = -2;
        defs = defs->next;
    }
    else
      if (!defs || uses->scrap < defs->scrap) {
      fputs("\\WEFTlink{weft", tex_file);
      write_scrap_ref(tex_file, uses->scrap, -1, &page);
      fputs("}{", tex_file);
      write_scrap_ref(tex_file, uses->scrap, TRUE, &page);
      fputs("}", tex_file);
      uses = uses->next;
    }
    else {
      if (defs->scrap == uses->scrap)
        uses = uses->next;
      fputs("\\underline{", tex_file);

      fputs("\\WEFTlink{weft", tex_file);
      write_single_scrap_ref(tex_file, defs->scrap);
      fputs("}{", tex_file);
      write_single_scrap_ref(tex_file, defs->scrap);
      fputs("}}", tex_file);
      page = -2;
      defs = defs->next;
    }
    while (uses || defs) {
      if (uses && (!defs || uses->scrap < defs->scrap)) {
        fputs("\\WEFTlink{weft", tex_file);
        write_scrap_ref(tex_file, uses->scrap, -1, &page);
        fputs("}{", tex_file);
        write_scrap_ref(tex_file, uses->scrap, FALSE, &page);
        fputs("}", tex_file);
        uses = uses->next;
      }
      else {
        if (uses && defs->scrap == uses->scrap)
          uses = uses->next;
        fputs(", \\underline{", tex_file);

        fputs("\\WEFTlink{weft", tex_file);
        write_single_scrap_ref(tex_file, defs->scrap);
        fputs("}{", tex_file);
        write_single_scrap_ref(tex_file, defs->scrap);
        fputs("}", tex_file);

        putc('}', tex_file);
        page = -2;
        defs = defs->next;
      }
    }
    fputs(".\n", tex_file);
  }
}@}

